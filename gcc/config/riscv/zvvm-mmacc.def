/* One entry per row of the IME specification's floating-point
   multiply-accumulate encoding map (tbl-fp-encoding-map) that GCC
   implements.  Each entry generates the operand table, the function
   group, the expander object and the function base of the row; the
   ime_fp_mmacc shape adds the _lm{N} and m16-accumulator forms.

     IME_FP_MMACC (NAME, INSN, C, A, B, UNSPEC)
     IME_OFP8_MMACC (NAME, INSN, C, A, B, UNSPEC)
     IME_INT_MX_MMACC (NAME, INSN, C, A, B, UNSPEC)

   NAME is the internal name of the function group and INSN the
   instruction.  C, A and B are the formats of the accumulator and the
   A and B inputs, named as in the encoding map: FP16, BF16, FP32, FP64,
   E4M3, E5M2 or E2M1.  UNSPEC selects the @pred_ime_mmacc_<ime_mmacc>
   insn pattern and, for IME_OFP8_MMACC, whose OFP8 accumulator or
   input formats share QImode, the altfmt bits.

   The same-format FP16, BF16, FP32 and FP64 rows of vfmmacc are a
   single function group, vfmmacc, outside this table.  The rows with
   mixed FP16 and BF16 inputs require the extensions of both.

   The ime_fp_mmacc shape also registers the microscaled forms of the
   rows that have them (the _scaled intrinsics), at block sizes 32 and
   16.  IME_INT_MX_MMACC gives the rows of the integer MX encoding map
   (tbl-intmx-encoding-map), whose instructions exist only in microscaled
   form; A and B are I8 or I4, which are signed.

   gen-zvvm-intrinsics.py reads this file to generate the tests and to
   compare it with the encoding map of the specification.  */

#ifndef IME_FP_MMACC
#define IME_FP_MMACC(NAME, INSN, C, A, B, UNSPEC)
#endif

#ifndef IME_OFP8_MMACC
#define IME_OFP8_MMACC(NAME, INSN, C, A, B, UNSPEC)
#endif

#ifndef IME_INT_MX_MMACC
#define IME_INT_MX_MMACC(NAME, INSN, C, A, B, UNSPEC)
#endif

/* vfmmacc.vv (W=1).  */
IME_FP_MMACC (vfmmacc_fp16_f16_bf16, vfmmacc, FP16, FP16, BF16,
	      UNSPEC_VFMMACC_FP16_F16_BF16)
IME_FP_MMACC (vfmmacc_fp16_bf16_f16, vfmmacc, FP16, BF16, FP16,
	      UNSPEC_VFMMACC_FP16_BF16_F16)
IME_FP_MMACC (vfmmacc_bf16_f16_bf16, vfmmacc, BF16, FP16, BF16,
	      UNSPEC_VFMMACC_BF16_F16_BF16)
IME_FP_MMACC (vfmmacc_bf16_bf16_f16, vfmmacc, BF16, BF16, FP16,
	      UNSPEC_VFMMACC_BF16_BF16_F16)
IME_OFP8_MMACC (vfmmacc_f8e4m3_f8e4m3_f8e4m3, vfmmacc, E4M3, E4M3, E4M3,
		UNSPEC_VFMMACC_F8_E4M3_E4M3_E4M3)
IME_OFP8_MMACC (vfmmacc_f8e4m3_f8e4m3_f8e5m2, vfmmacc, E4M3, E4M3, E5M2,
		UNSPEC_VFMMACC_F8_E4M3_E4M3_E5M2)
IME_OFP8_MMACC (vfmmacc_f8e4m3_f8e5m2_f8e4m3, vfmmacc, E4M3, E5M2, E4M3,
		UNSPEC_VFMMACC_F8_E4M3_E5M2_E4M3)
IME_OFP8_MMACC (vfmmacc_f8e4m3_f8e5m2_f8e5m2, vfmmacc, E4M3, E5M2, E5M2,
		UNSPEC_VFMMACC_F8_E4M3_E5M2_E5M2)
IME_OFP8_MMACC (vfmmacc_f8e5m2_f8e4m3_f8e4m3, vfmmacc, E5M2, E4M3, E4M3,
		UNSPEC_VFMMACC_F8_E5M2_E4M3_E4M3)
IME_OFP8_MMACC (vfmmacc_f8e5m2_f8e4m3_f8e5m2, vfmmacc, E5M2, E4M3, E5M2,
		UNSPEC_VFMMACC_F8_E5M2_E4M3_E5M2)
IME_OFP8_MMACC (vfmmacc_f8e5m2_f8e5m2_f8e4m3, vfmmacc, E5M2, E5M2, E4M3,
		UNSPEC_VFMMACC_F8_E5M2_E5M2_E4M3)
IME_OFP8_MMACC (vfmmacc_f8e5m2_f8e5m2_f8e5m2, vfmmacc, E5M2, E5M2, E5M2,
		UNSPEC_VFMMACC_F8_E5M2_E5M2_E5M2)

/* vfwmmacc.vv (W=2).  */
IME_OFP8_MMACC (vfwmmacc_f8e4m3_f4e2m1, vfwmmacc, E4M3, E2M1, E2M1,
		UNSPEC_VFWMMACC_OFP4_E4M3)
IME_OFP8_MMACC (vfwmmacc_f8e5m2_f4e2m1, vfwmmacc, E5M2, E2M1, E2M1,
		UNSPEC_VFWMMACC_OFP4_E5M2)
IME_FP_MMACC (vfwmmacc_f16, vfwmmacc, FP32, FP16, FP16, UNSPEC_VFWMMACC_F16)
IME_FP_MMACC (vfwmmacc_bf16, vfwmmacc, FP32, BF16, BF16, UNSPEC_VFWMMACC_BF16)
IME_FP_MMACC (vfwmmacc_f16_bf16, vfwmmacc, FP32, FP16, BF16,
	      UNSPEC_VFWMMACC_F16_BF16)
IME_FP_MMACC (vfwmmacc_bf16_f16, vfwmmacc, FP32, BF16, FP16,
	      UNSPEC_VFWMMACC_BF16_F16)
IME_FP_MMACC (vfwmmacc_f32, vfwmmacc, FP64, FP32, FP32, UNSPEC_VFWMMACC_F32)
IME_OFP8_MMACC (vfwmmacc_fp16_f8e4m3, vfwmmacc, FP16, E4M3, E4M3,
		UNSPEC_VFWMMACC_OFP8_FP16_E4M3)
IME_OFP8_MMACC (vfwmmacc_fp16_f8e4m3_f8e5m2, vfwmmacc, FP16, E4M3, E5M2,
		UNSPEC_VFWMMACC_OFP8_FP16_E4M3_E5M2)
IME_OFP8_MMACC (vfwmmacc_fp16_f8e5m2_f8e4m3, vfwmmacc, FP16, E5M2, E4M3,
		UNSPEC_VFWMMACC_OFP8_FP16_E5M2_E4M3)
IME_OFP8_MMACC (vfwmmacc_fp16_f8e5m2, vfwmmacc, FP16, E5M2, E5M2,
		UNSPEC_VFWMMACC_OFP8_FP16_E5M2)
IME_OFP8_MMACC (vfwmmacc_bf16_f8e4m3, vfwmmacc, BF16, E4M3, E4M3,
		UNSPEC_VFWMMACC_OFP8_BF16_E4M3)
IME_OFP8_MMACC (vfwmmacc_bf16_f8e4m3_f8e5m2, vfwmmacc, BF16, E4M3, E5M2,
		UNSPEC_VFWMMACC_OFP8_BF16_E4M3_E5M2)
IME_OFP8_MMACC (vfwmmacc_bf16_f8e5m2_f8e4m3, vfwmmacc, BF16, E5M2, E4M3,
		UNSPEC_VFWMMACC_OFP8_BF16_E5M2_E4M3)
IME_OFP8_MMACC (vfwmmacc_bf16_f8e5m2, vfwmmacc, BF16, E5M2, E5M2,
		UNSPEC_VFWMMACC_OFP8_BF16_E5M2)

/* vfqmmacc.vv (W=4).  */
IME_FP_MMACC (vfqmmacc_fp16_f4e2m1, vfqmmacc, FP16, E2M1, E2M1,
	      UNSPEC_VFQMMACC_OFP4_FP16)
IME_FP_MMACC (vfqmmacc_bf16_f4e2m1, vfqmmacc, BF16, E2M1, E2M1,
	      UNSPEC_VFQMMACC_OFP4_BF16)
IME_FP_MMACC (vfqmmacc_f16, vfqmmacc, FP64, FP16, FP16, UNSPEC_VFQMMACC_F16)
IME_FP_MMACC (vfqmmacc_bf16, vfqmmacc, FP64, BF16, BF16,
	      UNSPEC_VFQMMACC_BF16)
IME_FP_MMACC (vfqmmacc_f16_bf16, vfqmmacc, FP64, FP16, BF16,
	      UNSPEC_VFQMMACC_F16_BF16)
IME_FP_MMACC (vfqmmacc_bf16_f16, vfqmmacc, FP64, BF16, FP16,
	      UNSPEC_VFQMMACC_BF16_F16)
IME_OFP8_MMACC (vfqmmacc_f8e4m3, vfqmmacc, FP32, E4M3, E4M3,
		UNSPEC_VFQMMACC_F8E4M3)
IME_OFP8_MMACC (vfqmmacc_f8e5m2, vfqmmacc, FP32, E5M2, E5M2,
		UNSPEC_VFQMMACC_F8E5M2)
IME_OFP8_MMACC (vfqmmacc_f8e4m3_f8e5m2, vfqmmacc, FP32, E4M3, E5M2,
		UNSPEC_VFQMMACC_F8E4M3_E5M2)
IME_OFP8_MMACC (vfqmmacc_f8e5m2_f8e4m3, vfqmmacc, FP32, E5M2, E4M3,
		UNSPEC_VFQMMACC_F8E5M2_E4M3)

/* vf8wmmacc.vv (W=8).  */
IME_FP_MMACC (vf8wmmacc_f4e2m1, vf8wmmacc, FP32, E2M1, E2M1,
	      UNSPEC_VF8WMMACC_F4E2M1)
IME_OFP8_MMACC (vf8wmmacc_f8e4m3, vf8wmmacc, FP64, E4M3, E4M3,
		UNSPEC_VF8WMMACC_F8E4M3)
IME_OFP8_MMACC (vf8wmmacc_f8e5m2, vf8wmmacc, FP64, E5M2, E5M2,
		UNSPEC_VF8WMMACC_F8E5M2)
IME_OFP8_MMACC (vf8wmmacc_f8e4m3_f8e5m2, vf8wmmacc, FP64, E4M3, E5M2,
		UNSPEC_VF8WMMACC_F8E4M3_E5M2)
IME_OFP8_MMACC (vf8wmmacc_f8e5m2_f8e4m3, vf8wmmacc, FP64, E5M2, E4M3,
		UNSPEC_VF8WMMACC_F8E5M2_E4M3)

/* vfwimmacc.vv (W=2).  */
IME_INT_MX_MMACC (vfwimmacc_fp16_i8, vfwimmacc, FP16, I8, I8,
		  UNSPEC_VFWIMMACC)
IME_INT_MX_MMACC (vfwimmacc_bf16_i8, vfwimmacc, BF16, I8, I8,
		  UNSPEC_VFWIMMACC)

/* vfqimmacc.vv (W=4).  */
IME_INT_MX_MMACC (vfqimmacc_fp16_i4, vfqimmacc, FP16, I4, I4,
		  UNSPEC_VFQIMMACC)
IME_INT_MX_MMACC (vfqimmacc_bf16_i4, vfqimmacc, BF16, I4, I4,
		  UNSPEC_VFQIMMACC)
IME_INT_MX_MMACC (vfqimmacc_f32_i8, vfqimmacc, FP32, I8, I8,
		  UNSPEC_VFQIMMACC)

/* vf8wimmacc.vv (W=8).  */
IME_INT_MX_MMACC (vf8wimmacc_f32_i4, vf8wimmacc, FP32, I4, I4,
		  UNSPEC_VF8WIMMACC)
IME_INT_MX_MMACC (vf8wimmacc_f64_i8, vf8wimmacc, FP64, I8, I8,
		  UNSPEC_VF8WIMMACC)

#undef IME_FP_MMACC
#undef IME_OFP8_MMACC
#undef IME_INT_MX_MMACC
