#ifndef DEF_RVV_FUNCTION
#define DEF_RVV_FUNCTION(NAME, SHAPE, PREDS, OPS_INFO)
#endif

/* The multiply-accumulates and the pair and unpair intrinsics require
   any Zvvm extension; the shapes gate each multiply-accumulate on the
   individual extension of its input and accumulator formats, from
   riscv-ext-zvv.def.  */
#define REQUIRED_EXTENSIONS ZVVM_EXT

/* Integer multiply-accumulates.  Each entry names the instruction's
   default form (signed inputs at LMUL=1); the ime_int_mmacc shape
   registers its unsigned, _su and _us forms, the _lm{2,4,8} forms and
   the m16-accumulator forms.  The accumulator type suffix encodes SEW
   and MUL_C, e.g. __riscv_vmmacc_vv_i32m2.  */
DEF_RVV_FUNCTION (vmmacc, ime_int_mmacc, none_tu_preds, i_ime_vss_ops)
/* IME `pair' / `unpair' primitives.  Iterate over the m16 type list
   to produce one variant per (signedness, element size) pair:
       __riscv_ime_vpair_<i,u>{8,16,32,64}m16
       __riscv_ime_vunpairlo_<i,u>{8,16,32,64}m16
       __riscv_ime_vunpairhi_<i,u>{8,16,32,64}m16
   `pair' returns the iterating m16 type and takes two m8 halves of
   the same SEW; `unpairlo' / `unpairhi' take the m16 and return the
   matching m8 half.  None of these emit a vsetvl (no IME vtype
   setup) -- they lower post-RA to zero or more `vmv8r.v' moves.  */
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, i_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, u_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, i_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, u_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, i_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, u_ime_vunpair_ops)
/* vwmmacc.vv (W=2): accumulator at SEW, inputs at SEW/2.  */
DEF_RVV_FUNCTION (vwmmacc, ime_int_mmacc, none_tu_preds, i_ime_wvss_ops)
/* vqmmacc.vv (W=4): accumulator SEW, inputs SEW/4.  Only SI and DI
   accumulators have a valid quad-truncated integer input type.  */
DEF_RVV_FUNCTION (vqmmacc, ime_int_mmacc, none_tu_preds, i_ime_qvss_ops)
/* v8wmmacc.vv (W=8): accumulator SEW (DI only), inputs SEW/8.  */
DEF_RVV_FUNCTION (v8wmmacc, ime_int_mmacc, none_tu_preds, i_ime_8wvss_ops)

/* FP multiply-accumulates.  Each ime_fp_mmacc entry is one combination
   of accumulator and input formats, given in its default form (LMUL=1
   inputs, m1..m8 accumulator); the shape registers its _lm{2,4,8} and
   m16-accumulator forms and its microscaled forms, if any.  Except for
   the same-format FP16, BF16, FP32 and FP64 vfmmacc, they come from
   zvvm-mmacc.def, as do the integer-input microscaled ones, which the
   ime_int_mx_mmacc shape registers in microscaled form only.  */
DEF_RVV_FUNCTION (vfmmacc,     ime_fp_mmacc, none_tu_preds, f_ime_vss_ops)
#define IME_FP_MMACC(NAME, INSN, C, A, B, UNSPEC)			\
  DEF_RVV_FUNCTION (NAME, ime_fp_mmacc, none_tu_preds, NAME##_ime_ops)
#define IME_OFP8_MMACC(NAME, INSN, C, A, B, UNSPEC)			\
  DEF_RVV_FUNCTION (NAME, ime_fp_mmacc, none_tu_preds, NAME##_ime_ops)
#define IME_INT_MX_MMACC(NAME, INSN, C, A, B, UNSPEC)			\
  DEF_RVV_FUNCTION (NAME, ime_int_mx_mmacc, none_tu_preds, NAME##_ime_ops)
#include "zvvm-mmacc.def"
/* IME FP / OFP8 `pair' / `unpair' primitives at m16.  Mirror the
   integer i_/u_ entries above for each FP / OFP8 element type.
   Iterate over the per-format `f*_m16_ops' tables (one type per def).
   Reuses the existing `ime_vpair' / `ime_vunpair{lo,hi}' op classes:
   they dispatch on `e.vector_mode()' which falls within the VM16
   iterator already covering all m16 modes (int / FP / BF / OFP8).  */
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, f16_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, bf16_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, f32_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, f64_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, f8e4m3_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, f8e5m2_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, f16_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, bf16_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, f32_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, f64_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, f8e4m3_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, f8e5m2_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, f16_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, bf16_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, f32_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, f64_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, f8e4m3_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, f8e5m2_ime_vunpair_ops)

#undef REQUIRED_EXTENSIONS

/* Zvvmtls -- Order-preserving tile load (vmtl.v) and store (vmts.v).
   The ime_tile shape registers each with every _L{N} lambda immediate
   and _as_e{S} storage width.  The 4-bit types (Int4 and OFP4) are
   stored as bytes and take a uint8_t pointer.  */
#define REQUIRED_EXTENSIONS ZVVMTLS_EXT
DEF_RVV_FUNCTION (vmtl, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmts, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtl, ime_tile, none_m_preds,
		  i4_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmts, ime_tile, none_m_preds,
		  i4_lmul_ge1_v_scalar_ptr_ptrdiff_ops)
#undef REQUIRED_EXTENSIONS

/* Zvvmttls -- Transposing tile load (vmttl.v) and store (vmtts.v).
   Same forms as vmtl/vmts.  Sub-byte element types (OFP4,
   Int4) are excluded by spec: the transposition cannot be done at
   sub-byte granularity.  */
#define REQUIRED_EXTENSIONS ZVVMTTLS_EXT
DEF_RVV_FUNCTION (vmttl, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtts, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_ptr_ptrdiff_ops)
#undef REQUIRED_EXTENSIONS

/* IME geometry query builtins, available with any Zvvm extension.
   __riscv_ime_vlen()         returns VLEN in bits (compile-time or
                              runtime).
   __riscv_ime_lambda()       returns the maximum IME lambda value for
                              the hardware (sqrt(VLEN/8) for the
                              default SEW=8, MUL_C=1 case).
   __riscv_vsetlambda(N)      writes N into vtype.lambda (preserving
                              other vtype fields and vl) and returns
                              the WARL-clamped result; N=0 is a
                              read-only query.  */
#define REQUIRED_EXTENSIONS ZVVM_EXT
DEF_RVV_FUNCTION (ime_vlen,    vlenb,      none_preds, ul_none_void_ops)
DEF_RVV_FUNCTION (ime_lambda,  vlenb,      none_preds, ul_none_void_ops)
DEF_RVV_FUNCTION (vsetlambda,  vsetlambda, none_preds, ul_none_size_ops)
#undef REQUIRED_EXTENSIONS

#undef DEF_RVV_FUNCTION
