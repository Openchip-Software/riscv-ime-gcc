		  iu_lmul_ge1_v_scalar_ptr_ptrdiff_ops)
/* Immediate-lambda (_Lλ) variants of vmtl.v.  Each _L{N} overrides
   the dynamic vtype.lambda for the duration of the instruction.  */
DEF_RVV_FUNCTION (vmtl_L1,  ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtl_L2,  ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
