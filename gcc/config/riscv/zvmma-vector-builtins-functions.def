/* IME `pair' / `unpair' primitives.  Iterate over the m16 type list
   to produce one variant per (signedness, element size) pair:
       __riscv_ime_vpair_<i,u>{8,16,32,64}m16
       __riscv_ime_vunpairlo_<i,u>{8,16,32,64}m16
       __riscv_ime_vunpairhi_<i,u>{8,16,32,64}m16
   `pair' returns the iterating m16 type and takes two m8 halves of
   the same SEW; `unpairlo' / `unpairhi' take the m16 and return the
   matching m8 half.  None of these emit a vsetvl (no IME vtype
   setup) -- they lower post-RA to zero or more `vmv8r.v' moves.  */
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, i_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vpair,     ime_pair_unpair, none_preds, u_ime_vpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, i_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairlo, ime_pair_unpair, none_preds, u_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, i_ime_vunpair_ops)
DEF_RVV_FUNCTION (ime_vunpairhi, ime_pair_unpair, none_preds, u_ime_vunpair_ops)
/* vwmmacc.vv (W=2): accumulator at SEW, inputs at SEW/2.  Four sign
   combinations and four input-LMUL forms (default LMUL=1, plus _lm2,
   _lm4, _lm8 source-LMUL siblings, mirroring the W=1 mmacc family).
   Mixed-sign variants share the signed accumulator ops (i_ops) since
   the spec mandates a signed accumulator; the _su / _us suffixes on
   the generated name come from the ime_mmacc shape class decoding the
   internal base name.  */
DEF_RVV_FUNCTION (vwmmacc_s,      ime_mmacc, none_tu_preds, i_ime_wvss_ops)
DEF_RVV_FUNCTION (vwmmacc_u,      ime_mmacc, none_tu_preds, u_ime_wvss_ops)
DEF_RVV_FUNCTION (vwmmacc_su,     ime_mmacc, none_tu_preds, i_su_ime_wvss_ops)
