/* Microscaled (section 8) FP-input scaled variants.
   BS=32 extensions use Zvvx*, BS=16 extensions use Zvvxn*.
   For MVP, we gate on ZVVFMM (the base FP mmacc extension) since
   the individual Zvvx/Zvvxn target flags are not yet wired to
   command-line options.  This will be tightened in a follow-up.  */
#define REQUIRED_EXTENSIONS ZVVFMM_EXT
/* vfwmmacc_scaled (W=2): FP16 -> FP32, with block scales.  */
DEF_RVV_FUNCTION (vfwmmacc_scaled_f16_bs32, ime_mmacc, none_tu_preds,
		  f32_ime_scaled_wvss_f16_ops)
