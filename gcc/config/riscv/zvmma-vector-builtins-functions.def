/* Zvvmtls -- Order-preserving tile load (vmtl.v) and store (vmts.v),
   MVP.  LMUL=1 only, unmasked, dynamic lambda from vtype; larger
   LMULs, the immediate Lλ variants, and masked variants follow.  */
#define REQUIRED_EXTENSIONS ZVVMTLS_EXT
DEF_RVV_FUNCTION (vmtl, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
