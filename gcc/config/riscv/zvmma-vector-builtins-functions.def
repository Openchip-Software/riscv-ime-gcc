#ifndef DEF_RVV_FUNCTION
#define DEF_RVV_FUNCTION(NAME, SHAPE, PREDS, OPS_INFO)
#endif

/* Zvvmm - Vector integer matrix multiply-accumulate, W=1 (no widening),
   default LMUL=1 variant.  The accumulator type suffix on the generated
   name encodes both SEW and MUL_C, e.g. __riscv_vmmacc_vv_i32m2 is the
   signed variant with a 2-register accumulator.  vs1/vs2 always use the
   LMUL=1 form of the same SEW.

   Signed and unsigned share the user-visible base name "vmmacc"; the
   ime_mmacc shape class generates "__riscv_vmmacc_vv_i*" from the
   signed internal base (vmmacc_s) and "__riscv_vmmacc_vv_u*" from the
   unsigned one (vmmacc_u).  The two internal bases route to different
   UNSPECs at RTL level so the vsetvl pass can set altfmt_A/altfmt_B
   correctly in vtype.  The _lm{N} variants for LMUL > 1 and the
   _su / _us mixed-sign variants will be added in follow-ups.  */
#define REQUIRED_EXTENSIONS ZVVMM_EXT
DEF_RVV_FUNCTION (vmmacc_s,   ime_mmacc, none_tu_preds, i_ime_vss_ops)
DEF_RVV_FUNCTION (vmmacc_u,   ime_mmacc, none_tu_preds, u_ime_vss_ops)
/* vwmmacc.vv (W=2): accumulator at SEW, inputs at SEW/2 LMUL=1.
   Four sign combinations.  Mixed-sign variants share the signed
   accumulator ops (i_ops) since the spec mandates a signed
   accumulator; the _su / _us suffixes on the generated name come
   from the ime_mmacc shape class decoding the internal base
   name.  */
DEF_RVV_FUNCTION (vwmmacc_s,  ime_mmacc, none_tu_preds, i_ime_wvss_ops)
DEF_RVV_FUNCTION (vwmmacc_u,  ime_mmacc, none_tu_preds, u_ime_wvss_ops)
DEF_RVV_FUNCTION (vwmmacc_su, ime_mmacc, none_tu_preds, i_su_ime_wvss_ops)
DEF_RVV_FUNCTION (vwmmacc_us, ime_mmacc, none_tu_preds, i_us_ime_wvss_ops)
/* vqwmmacc.vv (W=4): accumulator SEW, inputs SEW/4 LMUL=1.  Only
   SI and DI accumulators have a valid quad-truncated integer input
   type.  */
DEF_RVV_FUNCTION (vqwmmacc_s,  ime_mmacc, none_tu_preds, i_ime_qwvss_ops)
DEF_RVV_FUNCTION (vqwmmacc_u,  ime_mmacc, none_tu_preds, u_ime_qwvss_ops)
DEF_RVV_FUNCTION (vqwmmacc_su, ime_mmacc, none_tu_preds, i_su_ime_qwvss_ops)
DEF_RVV_FUNCTION (vqwmmacc_us, ime_mmacc, none_tu_preds, i_us_ime_qwvss_ops)
/* v8wmmacc.vv (W=8): accumulator SEW (DI only), inputs SEW/8 LMUL=1.  */
DEF_RVV_FUNCTION (v8wmmacc_s,  ime_mmacc, none_tu_preds, i_ime_8wvss_ops)
DEF_RVV_FUNCTION (v8wmmacc_u,  ime_mmacc, none_tu_preds, u_ime_8wvss_ops)
DEF_RVV_FUNCTION (v8wmmacc_su, ime_mmacc, none_tu_preds, i_su_ime_8wvss_ops)
DEF_RVV_FUNCTION (v8wmmacc_us, ime_mmacc, none_tu_preds, i_us_ime_8wvss_ops)
#undef REQUIRED_EXTENSIONS

/* Zvvmtls -- Order-preserving tile load (vmtl.v) and store (vmts.v),
   MVP.  LMUL=1 only, unmasked, dynamic lambda from vtype; larger
   LMULs, the immediate Lλ variants, and masked variants follow.  */
#define REQUIRED_EXTENSIONS ZVVMTLS_EXT
DEF_RVV_FUNCTION (vmtl, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmts, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_ptr_ptrdiff_ops)
/* Immediate-lambda (_Lλ) variants of vmtl.v.  Each _L{N} overrides
   the dynamic vtype.lambda for the duration of the instruction.  */
DEF_RVV_FUNCTION (vmtl_L1,  ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtl_L2,  ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtl_L4,  ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtl_L8,  ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtl_L16, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtl_L32, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtl_L64, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
#undef REQUIRED_EXTENSIONS

/* Zvvmttls -- Transposing tile load (vmttl.v) and store (vmtts.v),
   MVP.  Same scope as vmtl/vmts.  Sub-byte element types (OFP4,
   Int4) are excluded by spec: the transposition cannot be done at
   sub-byte granularity.  */
#define REQUIRED_EXTENSIONS ZVVMTTLS_EXT
DEF_RVV_FUNCTION (vmttl, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_const_ptr_ptrdiff_ops)
DEF_RVV_FUNCTION (vmtts, ime_tile, none_m_preds,
		  iu_lmul_ge1_v_scalar_ptr_ptrdiff_ops)
#undef REQUIRED_EXTENSIONS

#undef DEF_RVV_FUNCTION
