#ifndef DEF_RVV_FUNCTION
#define DEF_RVV_FUNCTION(NAME, SHAPE, PREDS, OPS_INFO)
#endif

/* Zvvmm - Vector integer matrix multiply-accumulate, W=1 (no widening),
   default LMUL=1 variant.  The accumulator type suffix on the generated
   name encodes both SEW and MUL_C, e.g. __riscv_vmmacc_vv_i32m2 is the
   signed variant with a 2-register accumulator.  vs1/vs2 always use the
   LMUL=1 form of the same SEW.

   Signed and unsigned share the user-visible base name "vmmacc"; the
   ime_mmacc shape class generates "__riscv_vmmacc_vv_i*" from the
   signed internal base (vmmacc_s) and "__riscv_vmmacc_vv_u*" from the
   unsigned one (vmmacc_u).  The two internal bases route to different
   UNSPECs at RTL level so the vsetvl pass can set altfmt_A/altfmt_B
   correctly in vtype.  The _lm{N} variants below give vs1/vs2 LMUL=N
   at the same SEW as the accumulator (independent of MUL_C); the
   _su/_us mixed-sign variants (and their _lm{N} siblings) share the
   signed accumulator (i_ops) per the spec, with vs1/vs2 forced to
   opposite signedness via the lmul{N}_signed_vector /
   lmul{N}_unsigned_vector base types.  */
#define REQUIRED_EXTENSIONS ZVVMM_EXT
DEF_RVV_FUNCTION (vmmacc_s,     ime_mmacc, none_tu_preds, i_ime_vss_ops)
DEF_RVV_FUNCTION (vmmacc_u,     ime_mmacc, none_tu_preds, u_ime_vss_ops)
DEF_RVV_FUNCTION (vmmacc_s_lm2, ime_mmacc, none_tu_preds, i_ime_vss_lm2_ops)
DEF_RVV_FUNCTION (vmmacc_s_lm4, ime_mmacc, none_tu_preds, i_ime_vss_lm4_ops)
DEF_RVV_FUNCTION (vmmacc_s_lm8, ime_mmacc, none_tu_preds, i_ime_vss_lm8_ops)
DEF_RVV_FUNCTION (vmmacc_u_lm2, ime_mmacc, none_tu_preds, u_ime_vss_lm2_ops)
DEF_RVV_FUNCTION (vmmacc_u_lm4, ime_mmacc, none_tu_preds, u_ime_vss_lm4_ops)
DEF_RVV_FUNCTION (vmmacc_u_lm8, ime_mmacc, none_tu_preds, u_ime_vss_lm8_ops)
DEF_RVV_FUNCTION (vmmacc_su,     ime_mmacc, none_tu_preds, i_su_ime_vss_ops)
DEF_RVV_FUNCTION (vmmacc_us,     ime_mmacc, none_tu_preds, i_us_ime_vss_ops)
DEF_RVV_FUNCTION (vmmacc_su_lm2, ime_mmacc, none_tu_preds, i_su_ime_vss_lm2_ops)
DEF_RVV_FUNCTION (vmmacc_su_lm4, ime_mmacc, none_tu_preds, i_su_ime_vss_lm4_ops)
DEF_RVV_FUNCTION (vmmacc_su_lm8, ime_mmacc, none_tu_preds, i_su_ime_vss_lm8_ops)
DEF_RVV_FUNCTION (vmmacc_us_lm2, ime_mmacc, none_tu_preds, i_us_ime_vss_lm2_ops)
DEF_RVV_FUNCTION (vmmacc_us_lm4, ime_mmacc, none_tu_preds, i_us_ime_vss_lm4_ops)
DEF_RVV_FUNCTION (vmmacc_us_lm8, ime_mmacc, none_tu_preds, i_us_ime_vss_lm8_ops)
/* W=1 vmmacc with m16 accumulator (EMUL_C=16).  Same sign axes (s, u,
   su, us) and source-LMUL axes (default LMUL=1, _lm{2,4,8}) as the
   m1..m8 family, dispatched to the dedicated `*_m16<mode>' RTL
   patterns by the shape's name-mangling.  */
DEF_RVV_FUNCTION (vmmacc_s_m16,     ime_mmacc, none_tu_preds, i_ime_m16_vss_ops)
DEF_RVV_FUNCTION (vmmacc_u_m16,     ime_mmacc, none_tu_preds, u_ime_m16_vss_ops)
