DEF_RVV_FUNCTION (vwmmacc_u_lm4,  ime_mmacc, none_tu_preds, u_ime_wvss_lm4_ops)
DEF_RVV_FUNCTION (vwmmacc_u_lm8,  ime_mmacc, none_tu_preds, u_ime_wvss_lm8_ops)
DEF_RVV_FUNCTION (vwmmacc_su_lm2, ime_mmacc, none_tu_preds, i_su_ime_wvss_lm2_ops)
DEF_RVV_FUNCTION (vwmmacc_su_lm4, ime_mmacc, none_tu_preds, i_su_ime_wvss_lm4_ops)
DEF_RVV_FUNCTION (vwmmacc_su_lm8, ime_mmacc, none_tu_preds, i_su_ime_wvss_lm8_ops)
