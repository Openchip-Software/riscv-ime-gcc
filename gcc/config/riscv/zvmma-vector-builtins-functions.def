/* Zvvmttls -- Transposing tile load (vmttl.v) and store (vmtts.v),
   MVP.  Same scope as vmtl/vmts.  Sub-byte element types (OFP4,
   Int4) are excluded by spec: the transposition cannot be done at
   sub-byte granularity.  */
#define REQUIRED_EXTENSIONS ZVVMTTLS_EXT
