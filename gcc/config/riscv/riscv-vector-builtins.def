/* IME packed-in-bytes types.  These are opaque vector types that share
   the byte-vector machine mode (RVVM1QI) but are distinct C types for
   type checking in IME intrinsics.  No standalone arithmetic, load, or
   store intrinsics exist for these types.

   Int4: 4-bit integers packed two per byte.  */
DEF_RVV_TYPE (vint4m1_t, 14, __rvv_int4m1_t, int8, RVVM1QI, _i4m1, _i4,
	      _e8m1)
DEF_RVV_TYPE (vuint4m1_t, 15, __rvv_uint4m1_t, uint8, RVVM1QI, _u4m1, _u4,
	      _e8m1)
/* OFP8: 8-bit floating point (E4M3 and E5M2 formats).
   m1 / m2 / m4 / m8 acc variants are needed for the W=1 vfmmacc OFP8
   surface (gap #4 stage 3b); the W=4 / W=8 OFP8 patterns only
   reference these as inputs at LMUL=1.  */
DEF_RVV_TYPE (vfloat8e4m3m1_t, 20, __rvv_float8e4m3m1_t, uint8, RVVM1QI,
	      _f8e4m3m1, _f8e4m3, _e8m1)
