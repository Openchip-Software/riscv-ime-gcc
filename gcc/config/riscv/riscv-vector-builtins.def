/* IME (Zvmma) widening-input types: half the accumulator SEW at LMUL=1.
   These are appended at the END of the base-type list so their enum
   values do not shift the positional slot indices used by the
   DEF_RVV_TYPE_INDEX macro body.  Lookups bypass function_types[] via
   explicit dispatch in rvv_arg_type_info::get_function_type_index()
   and get_tree_type().  */
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul1_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul1_signed_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul1_unsigned_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_quad_trunc_lmul1_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_quad_trunc_lmul1_signed_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_quad_trunc_lmul1_unsigned_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_oct_trunc_lmul1_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_oct_trunc_lmul1_signed_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_oct_trunc_lmul1_unsigned_vector,
		   get_ime_widening_input_type (type_idx, base_type))

/* IME FP fixed-input base types: always return a specific LMUL=1 FP type
   regardless of the accumulator type.  Used for FP widening mmacc where
   the input format is independent of the accumulator SEW.  */
DEF_RVV_BASE_TYPE (ime_fp16_lmul1_vector,
		   builtin_types[VECTOR_TYPE_vfloat16m1_t].vector)
DEF_RVV_BASE_TYPE (ime_bf16_lmul1_vector,
		   builtin_types[VECTOR_TYPE_vbfloat16m1_t].vector)
DEF_RVV_BASE_TYPE (ime_fp32_lmul1_vector,
		   builtin_types[VECTOR_TYPE_vfloat32m1_t].vector)
DEF_RVV_BASE_TYPE (ime_f8e4m3_lmul1_vector,
		   builtin_types[VECTOR_TYPE_vfloat8e4m3m1_t].vector)
DEF_RVV_BASE_TYPE (ime_f8e5m2_lmul1_vector,
		   builtin_types[VECTOR_TYPE_vfloat8e5m2m1_t].vector)
DEF_RVV_BASE_TYPE (ime_f4e2m1_lmul1_vector,
		   builtin_types[VECTOR_TYPE_vfloat4e2m1m1_t].vector)

/* IME scales vector: always vuint16m1_t, used for the block-scale operand
   of microscaled (section 8) intrinsics.  */
DEF_RVV_BASE_TYPE (ime_scales_vector,
		   builtin_types[VECTOR_TYPE_vuint16m1_t].vector)

/* IME integer-input base types: always LMUL=1 signed/unsigned int8,
   used for the integer-input microscaled variants (vfwimmacc etc.).  */
DEF_RVV_BASE_TYPE (ime_i8_lmul1_vector,
		   builtin_types[VECTOR_TYPE_vint8m1_t].vector)

/* IME source-LMUL base types: for the W=1 mmacc _lm{N} variants, vs1/vs2
   use LMUL=N at the same SEW as the accumulator (independent of the
   accumulator's MUL_C).  These are appended at the END of the base-type
   list so their enum values do not shift positional slot indices used by
   DEF_RVV_TYPE_INDEX.  Lookups bypass function_types[] via explicit
   dispatch in rvv_arg_type_info::get_function_type_index() and
   get_tree_type().  */
DEF_RVV_BASE_TYPE (lmul2_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul4_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul8_vector,
		   get_ime_lmul_input_type (type_idx, base_type))

/* IME source-LMUL base types with explicit signedness.  Used for the
   W=1 mmacc mixed-sign (_su / _us) variants where vs1 and vs2 share
   the SEW and LMUL but use opposite signedness.  Each variant returns
   the signed or unsigned sibling at LMUL=N at the accumulator's SEW.  */
DEF_RVV_BASE_TYPE (lmul1_signed_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul1_unsigned_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul2_signed_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul2_unsigned_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul4_signed_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul4_unsigned_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul8_signed_vector,
		   get_ime_lmul_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (lmul8_unsigned_vector,
		   get_ime_lmul_input_type (type_idx, base_type))

/* IME widening source-LMUL base types: for the W={2,4,8} mmacc _lm{N}
   variants, vs1/vs2 use SEW/W and LMUL=N (independent of MUL_C).  These
   are appended at the END of the base-type list so their enum values do
   not shift positional slot indices used by DEF_RVV_TYPE_INDEX.  Lookups
   bypass function_types[] via explicit dispatch in
   rvv_arg_type_info::get_function_type_index() and get_tree_type().  */
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul2_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul2_signed_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul2_unsigned_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul4_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul4_signed_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul4_unsigned_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_double_trunc_lmul8_vector,
		   get_ime_widening_input_type (type_idx, base_type))
