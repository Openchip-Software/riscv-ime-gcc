	      _f8e4m3m4, _f8e4m3, _e8m4)
DEF_RVV_TYPE (vfloat8e4m3m8_t, 20, __rvv_float8e4m3m8_t, uint8, RVVM8QI,
	      _f8e4m3m8, _f8e4m3, _e8m8)
