	      _f8e5m2m1, _f8e5m2, _e8m1)
DEF_RVV_TYPE (vfloat8e5m2m2_t, 20, __rvv_float8e5m2m2_t, uint8, RVVM2QI,
	      _f8e5m2m2, _f8e5m2, _e8m2)
DEF_RVV_TYPE (vfloat8e5m2m4_t, 20, __rvv_float8e5m2m4_t, uint8, RVVM4QI,
	      _f8e5m2m4, _f8e5m2, _e8m4)
