DEF_RVV_BASE_TYPE (ime_oct_trunc_lmul8_unsigned_vector,
		   get_ime_widening_input_type (type_idx, base_type))

/* `void *' / `const void *' for IME `_as_e{S}' tile load/store
   intrinsics (spec §2983+): the base pointer is untyped because the
   logical type and storage element width are independent.  These
   entries are intentionally appended at the END of the base-type
   list -- inserting in the middle would shift the enum values of
   every later entry and corrupt the `function_types[].type_indexes[]'
   lookup that maps (vector_type_index, base_type) -> vector index.  */
DEF_RVV_BASE_TYPE (untyped_ptr, ptr_type_node)
DEF_RVV_BASE_TYPE (untyped_const_ptr, const_ptr_type_node)

/* IME FP fixed-input base types at LMUL > 1: same SEW as the LMUL=1
   sibling above, but with a wider input register group for the
   _lm{N} variants of the FP widening mmaccs.  Spec § 2614-2618 +
   § 2657: _lm{N} applies uniformly to FP and integer widening; the
   integer side has `ime_{double,quad,oct}_trunc_lmul{2,4,8}_*' as
   the wider-input counterparts of `_lmul1_*'.  These FP entries
   close the symmetry.  Like other entries appended past the
   DEF_RVV_TYPE_INDEX positional slot list, lookups for these types
   use `get_tree_type's switch path directly; the standard
   `function_types[].type_indexes[]' fallback is unused.  */
DEF_RVV_BASE_TYPE (ime_fp16_lmul2_vector,
		   builtin_types[VECTOR_TYPE_vfloat16m2_t].vector)
DEF_RVV_BASE_TYPE (ime_fp16_lmul4_vector,
		   builtin_types[VECTOR_TYPE_vfloat16m4_t].vector)
DEF_RVV_BASE_TYPE (ime_fp16_lmul8_vector,
		   builtin_types[VECTOR_TYPE_vfloat16m8_t].vector)
DEF_RVV_BASE_TYPE (ime_bf16_lmul2_vector,
		   builtin_types[VECTOR_TYPE_vbfloat16m2_t].vector)
DEF_RVV_BASE_TYPE (ime_bf16_lmul4_vector,
		   builtin_types[VECTOR_TYPE_vbfloat16m4_t].vector)
DEF_RVV_BASE_TYPE (ime_bf16_lmul8_vector,
		   builtin_types[VECTOR_TYPE_vbfloat16m8_t].vector)
DEF_RVV_BASE_TYPE (ime_fp32_lmul2_vector,
		   builtin_types[VECTOR_TYPE_vfloat32m2_t].vector)
DEF_RVV_BASE_TYPE (ime_fp32_lmul4_vector,
		   builtin_types[VECTOR_TYPE_vfloat32m4_t].vector)
DEF_RVV_BASE_TYPE (ime_fp32_lmul8_vector,
		   builtin_types[VECTOR_TYPE_vfloat32m8_t].vector)

/* OFP8 (E4M3 / E5M2) `_lm{N}' input base types, for the W=2 OFP8 ->
   FP16/BF16, W=4 OFP8 -> FP32 and W=8 OFP8 -> FP64 _lm{N} variants.  */
DEF_RVV_BASE_TYPE (ime_f8e4m3_lmul2_vector,
		   builtin_types[VECTOR_TYPE_vfloat8e4m3m2_t].vector)
DEF_RVV_BASE_TYPE (ime_f8e4m3_lmul4_vector,
		   builtin_types[VECTOR_TYPE_vfloat8e4m3m4_t].vector)
DEF_RVV_BASE_TYPE (ime_f8e4m3_lmul8_vector,
		   builtin_types[VECTOR_TYPE_vfloat8e4m3m8_t].vector)
DEF_RVV_BASE_TYPE (ime_f8e5m2_lmul2_vector,
		   builtin_types[VECTOR_TYPE_vfloat8e5m2m2_t].vector)
DEF_RVV_BASE_TYPE (ime_f8e5m2_lmul4_vector,
		   builtin_types[VECTOR_TYPE_vfloat8e5m2m4_t].vector)
DEF_RVV_BASE_TYPE (ime_f8e5m2_lmul8_vector,
		   builtin_types[VECTOR_TYPE_vfloat8e5m2m8_t].vector)

DEF_RVV_VXRM_ENUM (RNU, VXRM_RNU)
