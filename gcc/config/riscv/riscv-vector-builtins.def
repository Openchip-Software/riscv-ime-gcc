#include "riscv-vector-type-indexer.gen.def"

/* IME packed-in-bytes types: opaque types with no standard V type
   relationships.  All relationship slots are INVALID except VECTOR
   (self), MASK, and SIGNED/UNSIGNED for Int4.  */
DEF_RVV_TYPE_INDEX (
  /*VECTOR*/ vint4m1_t, /*MASK*/ vbool8_t,
  /*SIGNED*/ vint4m1_t, /*UNSIGNED*/ vuint4m1_t,
  /*SIGNED_EEW8_INDEX*/ INVALID, /*EEW8_INDEX*/ INVALID,
  /*EEW16_INDEX*/ INVALID, /*EEW32_INDEX*/ INVALID,
