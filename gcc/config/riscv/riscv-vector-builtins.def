	      _f8e5m2m8, _f8e5m2, _e8m8)
/* OFP4: 4-bit floating point (E2M1 format), packed two per byte.  */
DEF_RVV_TYPE (vfloat4e2m1m1_t, 20, __rvv_float4e2m1m1_t, uint8, RVVM1QI,
	      _f4e2m1m1, _f4e2m1, _e8m1)

/* IME-only `m16' accumulator types.  Valid only as the accumulator
   operand/result of an IME mmacc intrinsic when EMUL_C = 16, and as
   the operand/result of the IME pair/unpair pseudo-intrinsics.  The
   IME C API does not define ordinary `vsetvl_e{SEW}m16',
   `vle{SEW}_v_*m16', or `vse{SEW}_v_*m16' helpers for these types --
   the trailing `_eN' name slot is empty to reflect that.  */
DEF_RVV_TYPE (vint8m16_t, 15, __rvv_int8m16_t, int8, RVVM16QI,
	      _i8m16, _i8, )
