		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_quad_trunc_lmul2_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_quad_trunc_lmul2_signed_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_quad_trunc_lmul2_unsigned_vector,
		   get_ime_widening_input_type (type_idx, base_type))
DEF_RVV_BASE_TYPE (ime_quad_trunc_lmul4_vector,
		   get_ime_widening_input_type (type_idx, base_type))
